    "/api/roles/{role_id}/processes": {
      "get": {
        "tags": [
          "processes"
        ],
        "summary": "List Processes",
        "operationId": "processes-list_processes",
        "parameters": [
          {
            "name": "role_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Role Id"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
